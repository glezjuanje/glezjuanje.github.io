# Copia este archivo como .env para probar en local, o define estas variables
# en GitHub (Settings → Secrets and variables → Actions → Variables).
# Mientras PUBLIC_ADSENSE_CLIENT esté vacío, no se carga ningún script de AdSense.

# ID de editor, formato ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT=
# IDs de bloque (data-ad-slot) de cada hueco
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_END=
