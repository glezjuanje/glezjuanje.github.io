---
// Logo: modelo de estación simplificado. Círculo con nubosidad 4/8 (mitad
// rellena) y un asta con dos barbas completas (viento de ~20 kt del NO).
export interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 40 40" width={size} height={size} aria-hidden="true">
  <circle cx="24" cy="24" r="7" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
  <path d="M24 17a7 7 0 0 1 0 14Z" fill="currentColor"></path>
  <path d="M19 19 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
  <path d="M5 5 1.5 13M9.5 9.5 6 17.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
</svg>
