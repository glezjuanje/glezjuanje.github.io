---
import PostRow from './PostRow.astro';
import type { Post } from '../utils/posts';

export interface Props {
  posts: Post[];
  numbers: Map<string, string>;
}
const { posts, numbers } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title" class="label">
        Relacionados
      </h2>
      <ol>
        {posts.map((p) => (
          <PostRow post={p} number={numbers.get(p.id)} showDescription={false} headingLevel="h3" />
        ))}
      </ol>
    </section>
  )
}

<style>
  .related {
    margin-top: 3rem;
  }
  h2 {
    color: var(--text);
    border-bottom: 2px solid var(--rule);
    padding-bottom: 0.4rem;
    margin: 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ol :global(.row) {
    grid-template-columns: 4.5rem 7rem minmax(0, 1fr);
  }
  ol :global(.cat) {
    display: none;
  }
  ol :global(.title) {
    font-size: var(--step-0);
  }
</style>
