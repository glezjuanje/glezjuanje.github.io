---
/**
 * Figura con pie numerado automáticamente ("Figura 1.", "Figura 2."…).
 * Uso en MDX:
 *   import Figure from '../../components/Figure.astro';
 *   import grafico from '../../assets/blog/grafico.svg';
 *   <Figure src={grafico} alt="Descripción para lectores de pantalla" credit="Fuente: …">
 *     Texto del pie, admite **markdown** y $fórmulas$.
 *   </Figure>
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  credit?: string;
  wide?: boolean;
  width?: number;
  height?: number;
}
const { src, alt, credit, wide = false, width, height } = Astro.props;
// Las cadenas (URL) y los SVG se sirven tal cual; el resto pasa por el optimizador.
const plain = typeof src === 'string' ? { src, width, height } : src.format === 'svg' ? { src: src.src, width: width ?? src.width, height: height ?? src.height } : null;
---

<figure class:list={['fig', { 'fig--wide': wide }]}>
  {
    plain ? (
      <img src={plain.src} alt={alt} width={plain.width} height={plain.height} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} width={width} height={height} widths={[480, 800, 1200]} sizes="(min-width: 900px) 800px, 100vw" />
    )
  }
  <figcaption>
    <slot />
    {credit && <span class="credit">{credit}</span>}
  </figcaption>
</figure>
