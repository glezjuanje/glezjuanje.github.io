---
// Una línea del registro de artículos: número, fecha, título y categoría.
import FrontGlyph from './FrontGlyph.astro';
import { categoryUrl, formatShortDate, postUrl, type Post } from '../utils/posts';

export interface Props {
  post: Post;
  number?: string;
  showDescription?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { post, number, showDescription = true, headingLevel: H = 'h2' } = Astro.props;
const { title, description, date, category, draft } = post.data;
---

<li class="row">
  <span class="num mono">{draft ? 'BORR.' : `Nº ${number ?? '—'}`}</span>
  <time class="date mono" datetime={date.toISOString()}>{formatShortDate(date)}</time>
  <div class="body">
    <H class="title"><a href={postUrl(post)}>{title}</a></H>
    {showDescription && <p class="desc">{description}</p>}
  </div>
  <a class="cat mono" href={categoryUrl(category)}>
    <FrontGlyph category={category} width={24} />
    {category}
  </a>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 4.5rem 7rem minmax(0, 1fr) 11rem;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .num {
    color: var(--highlight);
    font-weight: 500;
  }
  .date {
    color: var(--text-muted);
  }
  .title {
    font-size: var(--step-1);
    line-height: 1.25;
    margin: 0;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .desc {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.95em;
    max-width: 60ch;
  }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: end;
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .cat:hover {
    color: var(--text);
  }
  @media (max-width: 820px) {
    .row {
      grid-template-columns: auto auto 1fr;
      gap: 0.35rem 1rem;
    }
    .body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .cat {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
